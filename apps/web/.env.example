# PrompTED web — browser-visible configuration only.
# Copy to .env.local for local development. Never place backend credentials,
# provider API keys, database passwords or deployment tokens in this file.

NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key"
NEXT_PUBLIC_API_BASE_URL="/api"
NEXT_PUBLIC_APP_ENV="development"

# Development/local must use a local or dedicated non-production Supabase
# project. The application refuses a production project in this mode.

# Optional public integrations.
NEXT_PUBLIC_REVENUECAT_WEB_KEY=""
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"
