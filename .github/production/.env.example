# PrompTED.AI - GitHub Actions production secret names
# Reference template for .github/workflows/deploy-prod.yml.
# This file contains no credentials and is not loaded by the workflow.
# Configure these names in the repository's production environment secrets,
# or repository Actions secrets where the workflow can resolve them.
# Keep populated copies outside Git; never overwrite this example with secrets.
# See docs/ENVIRONMENT_CONFIGURATION.md for local and hosted destinations.

# Supabase deployment authentication and exact production target
SUPABASE_ACCESS_TOKEN=
PROD_SUPABASE_PROJECT_REF=
PROD_SUPABASE_URL=
PROD_SUPABASE_DB_PASSWORD=
PROD_SUPABASE_SERVICE_ROLE_KEY=

# Browser-public values passed to the production web build
# PROD_SUPABASE_URL above also supplies NEXT_PUBLIC_SUPABASE_URL.
# The workflow explicitly supplies NEXT_PUBLIC_APP_ENV=production.
PROD_SUPABASE_ANON_KEY=
PROD_REVENUECAT_WEB_KEY=

# Netlify deployment authentication, exact site and production URL
NETLIFY_AUTH_TOKEN=
NETLIFY_PROD_SITE_ID=
PROD_WEB_URL=

# Approved OpenAI route models and routing version
# These names are release inputs, not the OpenAI API credential.
PROD_OPENAI_FAST_MODEL=
PROD_OPENAI_DEEP_MODEL=
PROD_OPENAI_RESEARCH_MODEL=
PROD_OPENAI_REVIEW_MODEL=
PROD_OPENAI_ROUTING_VERSION=

# Capacity evidence: exact fingerprints of existing approved records
# Do not generate arbitrary hashes or copy one route's evidence to another.
PROD_OPENAI_FAST_CAPACITY_FINGERPRINT=
PROD_OPENAI_DEEP_CAPACITY_FINGERPRINT=
PROD_OPENAI_RESEARCH_CAPACITY_FINGERPRINT=
PROD_OPENAI_REVIEW_CAPACITY_FINGERPRINT=

# Evaluation evidence: approved suite and exact route fingerprints
PROD_OPENAI_EVALUATION_SUITE_VERSION=
PROD_OPENAI_FAST_EVALUATION_FINGERPRINT=
PROD_OPENAI_DEEP_EVALUATION_FINGERPRINT=
PROD_OPENAI_RESEARCH_EVALUATION_FINGERPRINT=
PROD_OPENAI_REVIEW_EVALUATION_FINGERPRINT=
