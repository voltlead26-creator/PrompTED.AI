# PrompTED.AI local environment template
#
# Copy only the public browser values to apps/web/.env.local. Keep provider and
# service-role secrets in the protected Supabase environment. Never commit a
# populated environment file.

# Browser-visible Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Browser application contract
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=/api
# Required environment identity. A non-production value is refused if the URL
# resolves to the production project recorded in the deployment contract.
NEXT_PUBLIC_APP_ENV=development

# Optional browser-visible integrations
NEXT_PUBLIC_REVENUECAT_WEB_KEY=your-public-revenuecat-key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=

# Protected Supabase Edge Function configuration
# Reuse the existing OPENAI_API_KEY in its current secret store. Do not copy it
# into this file, Netlify, browser code, documentation, logs, or test fixtures.
OPENAI_API_KEY=
OPENAI_FAST_MODEL=gpt-5.6-luna
OPENAI_DEEP_MODEL=gpt-5.6-sol
OPENAI_RESEARCH_MODEL=gpt-5.6-terra
OPENAI_REVIEW_MODEL=gpt-5.6-sol
OPENAI_ROUTING_VERSION=routing.2026-08-pilot.1

# The captured-operation strangler is fail-closed unless a matching immutable
# activation revision is applied through the protected Supabase RPC.
PROMPTED_DEPLOYMENT_ENV=local
PROMPTED_CAPTURED_COHORT=disabled

# Protected PDF renderer contract. The endpoint must be HTTPS on this exact
# public origin, without URL credentials/query parameters. Captured PDFs are
# accepted only when this renderer attests structural, content, section-order,
# and artifact-hash checks using the prompted.rendered-pdf.v1 response headers.
RENDER_SERVICE_URL=https://renderer.your-production-domain.example/v1/pdf
RENDER_SERVICE_ALLOWED_ORIGIN=https://renderer.your-production-domain.example
RENDER_SERVICE_TIMEOUT_MS=15000
RENDER_SERVICE_MAX_BYTES=26214400

# Exact browser origins accepted by protected application functions
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.example

# Server-side billing integration
REVENUECAT_SECRET_KEY=replace-in-protected-supabase-environment

# Application mode
NODE_ENV=development
