{
  "name": "prompted-ai",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "22.23.2",
    "pnpm": "10.33.0"
  },
  "scripts": {
    "dev": "pnpm --filter @prompted/web dev",
    "build": "pnpm --filter @prompted/web build",
    "type-check": "pnpm -r type-check",
    "lint": "node scripts/check-agent-instructions.mjs && node scripts/check-text-encoding.mjs && node scripts/check-product-promises.mjs && node scripts/check-migrations.mjs && pnpm -r lint",
    "test": "node --test scripts/backend-release-baseline.test.mjs scripts/check-agent-instructions.test.mjs scripts/check-deployment-contract.test.mjs scripts/check-progressive-bundles.test.mjs scripts/check-supabase-secret-names.test.mjs scripts/deploy-contract-functions.test.mjs scripts/deploy-netlify-production.test.mjs scripts/immutable-source-import.test.mjs scripts/probe-supabase-contract.test.mjs scripts/verify-live-document-generation.test.mjs scripts/verify-live-document-review.test.mjs scripts/verify-web-release.test.mjs && pnpm -r test",
    "check:instructions": "node scripts/check-agent-instructions.mjs",
    "check:encoding": "node scripts/check-text-encoding.mjs",
    "check:promises": "node scripts/check-product-promises.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:immutable-import": "node scripts/immutable-source-import.mjs",
    "test:immutable-import": "node --test scripts/immutable-source-import.test.mjs",
    "check:progressive-bundles": "node scripts/check-progressive-bundles.mjs",
    "test:progressive-bundles": "node --test scripts/check-progressive-bundles.test.mjs",
    "check:deployment-contract": "node scripts/check-deployment-contract.mjs",
    "check:supabase-secret-names": "node scripts/check-supabase-secret-names.mjs",
    "test:deployment-contract": "node --test scripts/backend-release-baseline.test.mjs scripts/check-deployment-contract.test.mjs scripts/deploy-contract-functions.test.mjs scripts/deploy-netlify-production.test.mjs scripts/probe-supabase-contract.test.mjs",
    "test:generation-live-harness": "node --test scripts/verify-live-document-generation.test.mjs scripts/verify-live-document-review.test.mjs",
    "verify:generation-live": "node scripts/verify-live-document-generation.mjs",
    "verify:generation-live-review": "node scripts/verify-live-document-review.mjs",
    "verify:web": "node scripts/verify-web-release.mjs",
    "probe:supabase-contract": "node scripts/probe-supabase-contract.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "esbuild": "0.25.12",
      "tar": "7.5.22",
      "uuid": "11.1.1",
      "js-yaml@^3": "3.15.1",
      "js-yaml@^4": "4.3.1",
      "brace-expansion@^1": "1.1.18",
      "brace-expansion@^2": "2.1.4",
      "brace-expansion@^5": "5.0.9",
      "shell-quote": "1.9.0",
      "fast-uri": "3.1.5",
      "postcss": "8.5.23",
      "sharp": "0.35.0",
      "nanoid": "3.3.18",
      "undici": "6.28.0",
      "dompurify": "3.4.13",
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.2",
      "@types/node": "22.20.1"
    },
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "core-js",
      "esbuild",
      "sharp"
    ]
  }
}
